<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ipg.cooling.ResultController"
            stylesheets="@app.css"
            styleClass="root">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header-row">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="app-title" text="Laser water cooling"/>
                <Label fx:id="subtitleLabel" styleClass="subtitle" wrapText="true"
                       text="Tube sizing for heat removal: diameter, length and water flow"/>
            </VBox>
            <MenuButton fx:id="languageButton" styleClass="lang-button" text="RU"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" styleClass="root-scroll">
            <HBox spacing="16" alignment="TOP_LEFT" fillHeight="true">
                <VBox spacing="10" styleClass="card" minWidth="420" prefWidth="480" HBox.hgrow="ALWAYS">
                    <Label fx:id="inputsTitleLabel" styleClass="section-title" text="Input data"/>
                    <Label fx:id="autoHintLabel" styleClass="hint" wrapText="true" maxWidth="Infinity"/>

                    <GridPane hgap="10" vgap="8" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="240" fillWidth="true"
                                               halignment="LEFT"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="180" fillWidth="true"/>
                        </columnConstraints>

                        <Label fx:id="heatPowerLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="heatPowerField" text="500" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label fx:id="inletTempLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="inletTempField" text="20" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label fx:id="maxWallTempLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="maxWallTempField" text="45" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label fx:id="maxWaterRiseLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="maxWaterRiseField" text="8" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label fx:id="materialLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="materialBox" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label fx:id="wallThicknessLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="wallThicknessField" text="1" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label fx:id="maxPressureLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="maxPressureField" text="2" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Separator/>
                    <Label fx:id="optimizerTitleLabel" styleClass="section-title" text="Tube"/>
                    <Label fx:id="optimizerHintLabel" styleClass="hint" wrapText="true" maxWidth="Infinity"/>
                    <GridPane hgap="8" vgap="8" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="140" prefWidth="170" fillWidth="true"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="70" prefWidth="90" fillWidth="true"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="70" prefWidth="90" fillWidth="true"/>
                            <ColumnConstraints hgrow="NEVER" minWidth="70" prefWidth="80" halignment="CENTER"/>
                        </columnConstraints>

                        <Label fx:id="minHeaderLabel" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label fx:id="maxHeaderLabel" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="searchHeaderLabel" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label fx:id="innerDiameterLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="innerDiameterField" text="4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <TextField fx:id="diameterMaxField" text="12" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <CheckBox fx:id="varyDiameterBox" selected="true" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label fx:id="lengthLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="lengthField" text="200" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <TextField fx:id="lengthMaxField" text="600" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <CheckBox fx:id="varyLengthBox" selected="true" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                        <Label fx:id="flowLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="flowField" text="0.5" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <TextField fx:id="flowMaxField" text="2" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                        <CheckBox fx:id="varyFlowBox" selected="true" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                        <Label fx:id="iterationsLabel" styleClass="field-label" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="iterationsField" text="8" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>

                    <VBox spacing="8">
                        <HBox spacing="8">
                            <Button fx:id="calculateButton" defaultButton="true" onAction="#onCalculateButtonClick"
                                    styleClass="primary" minWidth="140" text="Calculate"/>
                            <Button fx:id="optimizeButton" onAction="#onOptimizeButtonClick" styleClass="secondary"
                                    minWidth="180" text="Optimize"/>
                        </HBox>
                        <Label fx:id="statusLabel" styleClass="status" wrapText="true" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <VBox spacing="10" styleClass="card" minWidth="380" prefWidth="460" HBox.hgrow="ALWAYS">
                    <Label fx:id="resultsTitleLabel" styleClass="section-title" text="Tube parameters"/>
                    <GridPane fx:id="resultGrid" hgap="12" vgap="6" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="140" prefWidth="200" maxWidth="280"
                                               fillWidth="true" halignment="LEFT"/>
                            <ColumnConstraints hgrow="NEVER" minWidth="160" prefWidth="180" fillWidth="true"
                                               halignment="LEFT"/>
                        </columnConstraints>

                        <Label fx:id="innerDiameterResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="innerDiameterResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label fx:id="outerDiameterResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="outerDiameterResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label fx:id="lengthResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lengthResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label fx:id="flowResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="flowResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label fx:id="velocityResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="velocityResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Separator GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

                        <Label fx:id="reynoldsResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label fx:id="reynoldsResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label fx:id="regimeResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Label fx:id="regimeResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label fx:id="htcResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <Label fx:id="htcResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <Label fx:id="waterRiseResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                        <Label fx:id="waterRiseResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                        <Label fx:id="outletTempResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                        <Label fx:id="outletTempResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="10" GridPane.columnIndex="1"/>

                        <Label fx:id="wallTempResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                        <Label fx:id="wallTempResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                        <Label fx:id="efficiencyResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                        <Label fx:id="efficiencyResult" styleClass="value value-best" wrapText="true" minWidth="140"
                               GridPane.rowIndex="12" GridPane.columnIndex="1"/>

                        <Label fx:id="pressureResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="13" GridPane.columnIndex="0"/>
                        <Label fx:id="pressureResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="13" GridPane.columnIndex="1"/>

                        <Label fx:id="resistanceResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="14" GridPane.columnIndex="0"/>
                        <Label fx:id="resistanceResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="14" GridPane.columnIndex="1"/>

                        <Label fx:id="evaluatedResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="15" GridPane.columnIndex="0"/>
                        <Label fx:id="evaluatedResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="15" GridPane.columnIndex="1"/>

                        <Label fx:id="feasibleResultLabel" styleClass="field-label" wrapText="true" maxWidth="260"
                               GridPane.rowIndex="16" GridPane.columnIndex="0"/>
                        <Label fx:id="feasibleResult" styleClass="value" wrapText="true" minWidth="140"
                               GridPane.rowIndex="16" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Label fx:id="recommendationTitleLabel" styleClass="section-title" text="Recommendation"/>
                    <TextArea fx:id="recommendationArea" wrapText="true" editable="false" prefRowCount="5"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
